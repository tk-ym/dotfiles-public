{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "language": "japanese",
    "model": "opus",        
    "statusLine": {
	"type": "command",
	"command": "ccstatusline",
	"padding": 0,
	"refreshInterval": 10
    },
    "editorMode": "normal",
    "preferredNotifChannel": "auto",
    "autoScrollEnabled": true,
    "agentPushNotifEnabled": false,
    "permissions":{
	"deny": [
	    "Bash(rm -rf *)",
	    "Bash(rm -fr *)",
	    "Bash(sudo *)",
	    "Bash(chmod -R 777 *)",
	    "Bash(op *)",
	    "Bash(* op read *)",
	    "Bash(* op run *)",
	    "Bash(* op inject *)",
	    "Read(~/.zsh_history)",
	    "Read(~/.bash_history)",
	    "Read(~/.claude.json)",
	    "Read(~/.ssh/**)",
	    "Read(~/.aws/**)",
	    "Read(~/.gnupg/**)",
	    "Read(~/.kube/**)",
	    "Read(~/.config/gh/**)",
	    "Read(~/.config/gcloud/**)",
	    "Read(~/.azure/**)",
	    "Read(~/.docker/config.json)",
	    "Read(~/.netrc)",
	    "Read(~/.npmrc)",
	    "Read(~/.pypirc)",
	    "Read(~/.git-credentials)",
	    "Read(~/.vault-token)",
	    "Read(~/.terraform.d/credentials.tfrc.json)",
	    "Read(**/.env*)",
	    "Read(**/.envrc)",
	    "Read(**/secrets/**)",
	    "Read(**/credentials/**)",
	    "Read(**/*credentials*)",
	    "Read(**/*.pem)",
	    "Read(**/*.key)",
	    "Read(**/*.p12)",
	    "Read(**/*.pfx)",
	    "Read(**/*.jks)",
	    "Read(**/*.keystore)",
	    "Read(**/id_rsa*)",
	    "Read(**/id_ed25519*)",
	    "Read(**/id_ecdsa*)",
	    "Read(**/*.tfstate)",
	    "Read(**/*.tfstate.backup)",
	    "Read(**/*.kubeconfig)",
	    "Read(**/admin.conf)",
	    "Read(~/Library/Keychains/**)",
	    "Read(~/.config/op/**)",
	    "Read(~/Library/Group Containers/2BUA8C4S2C.com.1password/**)",
	    "Read(~/Library/Application Support/1Password/**)"
	]
    },
    "sandbox": {
	"enabled": true,
	"autoAllowBashIfSandboxed": false,
	"allowUnsandboxedCommands": true,
	"excludedCommands": [
	],
	"filesystem": {
	    "denyRead": [
		"~/.ssh",
		"~/.aws",
		"~/.kube",
		"~/.gnupg",
		"~/.config/gh",
		"~/.netrc",
		"~/.docker/config.json",
		"~/.config/gcloud",
		"~/.azure",
		"~/.npmrc",
		"~/.pypirc",
		"~/.git-credentials",
		"~/.vault-token",
		"~/.terraform.d",
		"~/Library/Keychains",
		"~/.zsh_history",
		"~/.bash_history",
		"~/.claude.json",
		"~/.config/op",
		"~/Library/Group Containers/2BUA8C4S2C.com.1password",
		"~/Library/Application Support/1Password"
	    ]
	}
    },
    "hooks": {}
}
